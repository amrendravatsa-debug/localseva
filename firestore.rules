rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- सहायक फ़ंक्शन ----------
    function signedIn() { return request.auth != null; }
    // मालिक: सिर्फ़ Google से साइन-इन, सत्यापित ईमेल
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'amrendravatsa@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }
    function cfgDoc() { return /databases/$(database)/documents/config/app; }
    function cfgPct() { return exists(cfgDoc()) ? get(cfgDoc()).data.get('commissionPct', 10) : 10; }
    function cfgLimit() { return exists(cfgDoc()) ? get(cfgDoc()).data.get('dueLimit', 300) : 300; }
    function cfgTimeout() { return exists(cfgDoc()) ? get(cfgDoc()).data.get('timeoutMin', 120) : 120; }
    function blocksPath(uid) { return /databases/$(database)/documents/blocks/$(uid); }
    function blockedBy(owner, who) { return exists(blocksPath(owner)) && who in get(blocksPath(owner)).data.get('ids', []); }
    function duesPath(uid) { return /databases/$(database)/documents/providerDues/$(uid); }
    function isNum(x) { return x is number; }
    function strIn(x, lo, hi) { return x is string && x.size() >= lo && x.size() <= hi; }
    function validService(s) {
      return s in ['barber','plumber','electrician','laundry','dairy','pandit','appliance','tent',
                   'mistri','cleaning','beauty','maid','banquet','marriage','hotel',
                   'rider','caretaker','nurse','doctorvisit','escort'];
    }
    function optNum(d, k, lo, hi) {
      return !(k in d) || (isNum(d[k]) && d[k] >= lo && d[k] <= hi);
    }
    // लोकेशन/यात्रा-शुल्क/UPI जैसे वैकल्पिक फ़ील्ड
    function extrasOk(d) {
      return optNum(d, 'lat', 6, 38) && optNum(d, 'lng', 68, 98)
        && optNum(d, 'freeKm', 0, 200) && optNum(d, 'perKm', 0, 100) && optNum(d, 'maxKm', 0, 500)
        && (!('upi' in d) || (d.upi is string && d.upi.size() <= 60
              && (d.upi == '' || d.upi.matches('^[A-Za-z0-9._-]{2,}@[A-Za-z]{2,}$'))));
    }
    // प्रोवाइडर की रेट-सीमा ठीक है: सबसे कम <= शुरुआती, और मोलभाव चालू हो तो सबसे कम > 0
    function priceOk(d) {
      return d.bargain is bool && isNum(d.pMax) && isNum(d.pMin)
        && d.pMin >= 0 && d.pMax >= d.pMin && d.pMax <= 1000000
        && (d.bargain == false || d.pMin > 0);
    }
    // बुकिंग का रेट: मोलभाव से तय हुआ हो तो प्रोवाइडर की [सबसे कम, शुरुआती] सीमा के भीतर ही
    function offerOk(d, p) {
      return (d.bargained == false && d.bargainRounds == 0 && d.firstOffer == null
              && (d.offer == null || (isNum(d.offer) && d.offer > 0 && d.offer <= 1000000)))
          || (d.bargained == true && p.get('bargain', false) == true
              && d.bargainRounds is int && d.bargainRounds >= 1 && d.bargainRounds <= 3
              && isNum(d.firstOffer) && isNum(d.offer)
              && d.offer >= p.pMin && d.offer <= p.pMax);
    }
    function bookingCreateOk(d, p) {
      return d.keys().hasOnly(['customerId','customerName','customerPhone','providerId','providerName','providerPhone',
                               'service','address','when','note','bulk','qty','offer','status',
                               'bargained','bargainRounds','firstOffer','createdAt','distKm','travel'])
        && d.keys().hasAll(['customerId','customerName','customerPhone','providerId','providerName','providerPhone',
                            'service','address','when','note','bulk','qty','offer','status',
                            'bargained','bargainRounds','firstOffer','createdAt'])
        && d.customerId == request.auth.uid
        && d.providerId != request.auth.uid
        && d.status == 'नया'
        && d.createdAt == request.time
        && strIn(d.customerName, 1, 80)
        && d.customerPhone is string && d.customerPhone.matches('^[6-9][0-9]{9}$')
        && p.get('active', false) == true
        && p.get('suspended', false) == false
        && d.service == p.service
        && d.providerName == p.name
        && d.providerPhone == ''
        && strIn(d.address, 1, 300) && strIn(d.when, 1, 100) && strIn(d.note, 0, 500)
        && d.bulk is bool && strIn(d.qty, 0, 100)
        && (!('distKm' in d) || d.distKm == null || (isNum(d.distKm) && d.distKm >= 0 && d.distKm <= 1000))
        && (!('travel' in d) || (isNum(d.travel) && d.travel >= 0 && d.travel <= 5000))
        && offerOk(d, p);
    }
    // स्थिति सिर्फ़ आगे बढ़ सकती है: नया → स्वीकार → हाज़िर → पूरा (रद्द पूरा होने से पहले कभी भी)
    function statusMove(a, b) {
      return (a == 'नया' && (b == 'स्वीकार' || b == 'रद्द'))
          || (a == 'स्वीकार' && (b == 'हाज़िर' || b == 'रद्द'))
          || (a == 'हाज़िर' && b == 'पूरा');
    }
    function reviewOk(d, b) {
      return d.keys().hasOnly(['bookingId','customerId','customerName','providerId','service','rating','comment','createdAt'])
        && d.customerId == request.auth.uid
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && b.customerId == request.auth.uid
        && b.status == 'पूरा'
        && b.providerId == d.providerId
        && d.service == b.service
        && strIn(d.customerName, 1, 80)
        && (!('comment' in d) || strIn(d.comment, 0, 300))
        && d.createdAt == request.time;
    }

    // ---------- प्रोवाइडर ----------
    // सब (लॉगिन वाले) देख सकते हैं। अपनी प्रोफ़ाइल खुद बना/बदल सकते हैं,
    // पर "verified" (जाँचा हुआ) का निशान सिर्फ़ आप Firebase कंसोल से लगा सकते हैं।
    match /providers/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['service','name','area','rate','about','bargain','pMax','pMin','active','createdAt','lat','lng','freeKm','perKm','maxKm','upi','terms','ref'])
        && request.resource.data.keys().hasAll(['service','name','area','rate','bargain','pMax','pMin','active','createdAt','terms'])
        && validService(request.resource.data.service)
        && strIn(request.resource.data.name, 1, 80)
        && strIn(request.resource.data.area, 1, 80)
        && strIn(request.resource.data.rate, 1, 80)
        && (!('about' in request.resource.data) || strIn(request.resource.data.about, 0, 300))
        && priceOk(request.resource.data) && extrasOk(request.resource.data)
        && request.resource.data.terms == 'v1'
        && (!('ref' in request.resource.data)
            || (request.resource.data.ref is string && request.resource.data.ref != uid
                && exists(/databases/$(database)/documents/saathis/$(request.resource.data.ref))
                && get(/databases/$(database)/documents/saathis/$(request.resource.data.ref)).data.status == 'approved'))
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;
      allow update: if (signedIn() && request.auth.uid == uid
        && request.resource.data.get('verified', false) == resource.data.get('verified', false)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['service','name','phone','area','rate','about','bargain','pMax','pMin','active','lat','lng','freeKm','perKm','maxKm','upi','terms'])
        && extrasOk(request.resource.data)
        && !('phone' in request.resource.data)
        && (!('terms' in request.resource.data) || request.resource.data.terms == 'v1')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bargain','pMax','pMin'])
            || priceOk(request.resource.data)))
        || isAdmin();
      // हटाना: बकाया चुकाने के बाद ही
      allow delete: if (signedIn() && request.auth.uid == uid
        && (!exists(duesPath(uid)) || get(duesPath(uid)).data.owed - get(duesPath(uid)).data.paid <= 0))
        || isAdmin();
      // Google साइन-इन चालू करने के बाद create में यह शर्त जोड़ें:
      //   && request.auth.token.firebase.sign_in_provider != 'anonymous'
    }

    // ---------- प्रोवाइडर का निजी फ़ोन: सिर्फ़ वही देख सकता है ----------
    match /providers_private/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['phone'])
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[6-9][0-9]{9}$');
    }

    // ---------- काम पूरा करने का 4 अंक का कोड: सिर्फ़ ग्राहक देख सकता है ----------
    match /bookingSecrets/{id} {
      allow read: if signedIn() && resource.data.customerId == request.auth.uid;
      allow delete: if signedIn() && (resource == null || resource.data.customerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['customerId','otp'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.otp is string && request.resource.data.otp.matches('^[0-9]{4}$')
        && getAfter(/databases/$(database)/documents/bookings/$(id)).data.customerId == request.auth.uid;
      allow update: if false;
    }

    // ---------- बुकिंग ----------
    // सिर्फ़ संबंधित ग्राहक और प्रोवाइडर देख सकते हैं
    match /bookings/{id} {
      allow create: if signedIn()
        && !blockedBy(request.resource.data.providerId, request.auth.uid)
        && bookingCreateOk(request.resource.data,
             get(/databases/$(database)/documents/providers/$(request.resource.data.providerId)).data);
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.providerId == request.auth.uid
            || isAdmin());
      allow update: if signedIn() && (
        (resource.data.providerId == request.auth.uid && (
            // स्वीकार: प्रोवाइडर का नंबर इसी वक़्त बुकिंग में जुड़ता है
            (resource.data.status == 'नया' && request.resource.data.status == 'स्वीकार'
              && request.time < resource.data.createdAt + duration.value(cfgTimeout(), 'm')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','providerPhone'])
              && request.resource.data.providerPhone == get(/databases/$(database)/documents/providers_private/$(request.auth.uid)).data.phone
              && get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.get('terms', '') == 'v1'
              && (!exists(duesPath(request.auth.uid))
                  || get(duesPath(request.auth.uid)).data.owed - get(duesPath(request.auth.uid)).data.paid <= cfgLimit()))
            // बाक़ी आगे की स्थितियाँ (पूरा को छोड़कर)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && statusMove(resource.data.status, request.resource.data.status)
              && request.resource.data.status != 'पूरा'
              && request.resource.data.status != 'स्वीकार')
            // पूरा: ग्राहक का 4 अंक का कोड मिलना ज़रूरी (पुरानी बुकिंग जिनमें कोड नहीं, उन पर छूट)
            || (resource.data.status == 'हाज़िर' && request.resource.data.status == 'पूरा'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','otpCode','amount','commission'])
              && request.resource.data.otpCode is string
              && (!exists(/databases/$(database)/documents/bookingSecrets/$(id))
                  || get(/databases/$(database)/documents/bookingSecrets/$(id)).data.otp == request.resource.data.otpCode)
              && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
              && (resource.data.get('offer', null) == null
                  || request.resource.data.amount >= resource.data.offer + resource.data.get('travel', 0))
              && request.resource.data.commission == math.ceil(request.resource.data.amount * cfgPct() / 100)
              && getAfter(duesPath(request.auth.uid)).data.lastBooking == id
              && getAfter(duesPath(request.auth.uid)).data.owed
                   == (exists(duesPath(request.auth.uid)) ? get(duesPath(request.auth.uid)).data.owed : 0) + request.resource.data.commission)
            // भुगतान मिला
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid'])
              && request.resource.data.paid == true
              && resource.data.status == 'पूरा'
              && resource.data.get('paid', false) == false)
        ))
        || (resource.data.customerId == request.auth.uid && (
            // ग्राहक रद्द कर सकता है (स्वीकार होने से पहले या बाद में, हाज़िर होने से पहले)
            ((resource.data.status == 'नया' || resource.data.status == 'स्वीकार')
              && request.resource.data.status == 'रद्द'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledBy'])
              && request.resource.data.cancelledBy in ['customer', 'timeout'])
            // रकम पर आपत्ति
            || (resource.data.status == 'पूरा'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disputed'])
              && request.resource.data.disputed == true)
            // खाता हटाने पर निजी जानकारी मिटाना
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerName','customerPhone','address','note','deleted'])
              && request.resource.data.deleted == true)
        ))
      );
      allow delete: if false;
    }

    // ---------- कमीशन का बकाया खाता ----------
    // बढ़ता सिर्फ़ तभी है जब उसी batch में बुकिंग OTP से "पूरा" हो; घटता सिर्फ़ मालिक के हाथ से
    match /providerDues/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || resource.data.get('ref', '') == request.auth.uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['owed','paid','jobs','lastBooking','ref','firstJobAt'])
        && request.resource.data.paid == 0 && request.resource.data.jobs == 1
        && request.resource.data.ref == get(/databases/$(database)/documents/providers/$(uid)).data.get('ref', '')
        && request.resource.data.firstJobAt == request.time
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.lastBooking)).data.providerId == uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.lastBooking)).data.status != 'पूरा'
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastBooking)).data.status == 'पूरा'
        && request.resource.data.owed == getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastBooking)).data.commission;
      allow update: if (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owed','jobs','lastBooking'])
        && request.resource.data.jobs == resource.data.jobs + 1
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.lastBooking)).data.providerId == uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.lastBooking)).data.status != 'पूरा'
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastBooking)).data.status == 'पूरा'
        && request.resource.data.owed == resource.data.owed
             + getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastBooking)).data.commission)
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- बकाया भुगतान की सूचना (UTR) — मंज़ूरी मालिक देता है ----------
    match /settlements/{id} {
      allow read: if signedIn() && (resource.data.providerId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['providerId','amount','utr','status','createdAt'])
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 100000
        && request.resource.data.utr is string && request.resource.data.utr.matches('^[A-Za-z0-9]{6,24}$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------- सेटिंग (कमीशन %, सीमा, हाज़िर की UPI) ----------
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- शिकायत और ब्लॉक ----------
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterId','reportedId','bookingId','role','reason','text','status','createdAt'])
        && request.resource.data.keys().hasAll(['reporterId','reportedId','bookingId','role','reason','status','createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedId is string && request.resource.data.reportedId != request.auth.uid
        && request.resource.data.role in ['customer','provider']
        && strIn(request.resource.data.reason, 1, 80)
        && (!('text' in request.resource.data) || strIn(request.resource.data.text, 0, 500))
        && request.resource.data.status == 'नया'
        && request.resource.data.createdAt == request.time
        && request.resource.data.bookingId is string
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && (get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerId == request.auth.uid
            || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId == request.auth.uid);
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /blocks/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ids'])
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 200;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- शहर की खासियत: दुकानें (सिर्फ़ एडमिन लिखे) ----------
    match /shops/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- हाज़िर साथी ----------
    match /saathis/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','phone','city','code','status','createdAt'])
        && strIn(request.resource.data.name, 1, 80) && strIn(request.resource.data.city, 1, 80)
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /saathiCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/saathis/$(request.auth.uid)).data.code == code;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- वीडियो बातचीत के अनुरोध ----------
    match /videoRequests/{id} {
      allow create, update: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && id == request.resource.data.providerId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['providerId','customerId','customerName','customerPhone','room','createdAt'])
        && strIn(request.resource.data.customerName, 1, 80)
        && strIn(request.resource.data.room, 1, 200);
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.providerId == request.auth.uid);
      allow delete: if signedIn() && resource.data.customerId == request.auth.uid;
    }

    // ---------- रेटिंग ----------
    // सिर्फ़ उसी ग्राहक से, जिसकी बुकिंग "पूरा" हो चुकी हो, हर बुकिंग पर सिर्फ़ एक बार
    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.bookingId == id
        && reviewOk(request.resource.data,
             get(/databases/$(database)/documents/bookings/$(id)).data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.customerId == request.auth.uid;
    }
  }
}
